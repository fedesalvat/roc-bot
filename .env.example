# ─────────────────────────────────────────────
# ROC BOT — Variables de entorno
# Copiá este archivo a .env y completá los valores
# ─────────────────────────────────────────────

# Token que vos inventás y cargás en el dashboard de Meta
# (Webhook → Verify Token)
VERIFY_TOKEN=roc_webhook_token_2026

# Token de página de Facebook/Instagram (generado en Meta Developer)
PAGE_ACCESS_TOKEN=

# App Secret de tu app de Meta (para verificar firmas del webhook)
APP_SECRET=

# Puerto del servidor (Railway lo asigna automáticamente)
PORT=3000

# ID de la página de Instagram/Facebook conectada
# (opcional, para logs)
PAGE_ID=

# API Key de Resend (para digest diario de preguntas sin respuesta)
# Crear cuenta en resend.com → Settings → API Keys
# Verificar dominio rocargentina.com en Resend → Domains
RESEND_API_KEY=
